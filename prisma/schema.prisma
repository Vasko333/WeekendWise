generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Search {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  locationInput   String
  resolvedName    String
  latitude        Float
  longitude       Float
  timezone        String
  requestText     String
  activityLabel   String
  parserUsed      String   // "keyword" | "llm"
  intentJson      String   // Intent as JSON — SQLite has no Json type in Prisma
  resultJson      String   // Recommendation as JSON (candidates + bestWindow)
  bestWindowStart String?  // denormalized for the history list
  bestWindowEnd   String?
  meanScore       Float?
}
